classDiagram
    %% PawPal+ — smart pet care management system
    %% Keep this file updated so it matches your final implementation in pawpal_system.py

    class Owner {
        +str name
        +str email
        +str contact
        +int available_minutes
        +time day_start
        +List~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(pet_name: str) bool
        +get_pet(pet_name: str) Pet
        +get_all_tasks(pending_only: bool) List~Task~
    }

    class Pet {
        +str name
        +str species
        +str breed
        +float age_years
        +str notes
        +str pet_id
        +List~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task_id: str) bool
        +update_task(task_id: str, fields: dict) Task
        +pending_tasks() List~Task~
        +get_pending_tasks() List~Task~
        +complete_task(task_id: str) Optional~Task~
    }

    class Task {
        +str task_id
        +str title
        +str description
        +str category
        +int duration_minutes
        +str priority
        +time preferred_time
        +bool completed
        +time start_time
        +time scheduled_time
        +datetime scheduled_datetime
        +str pet_name
        +str recurrence
        +weight() float
        +create_next_occurrence() Optional~Task~
        +mark_complete() Optional~Task~
        +mark_pending() None
        +describe() str
    }

    class Scheduler {
        +str strategy
        +Owner owner
        +List~Task~ tasks
        +add_task(task: Task) None
        +complete_task(task_id: str) Optional~Task~
        +build_plan(owner: Owner, pets: Any) dict
        +sort_tasks(tasks: List~Task~) List~Task~
        +filter_by_time(tasks: List~Task~, budget: int) List~Task~
        +assign_times(tasks: List~Task~, day_start: time) List~Task~
        +get_daily_schedule(target: Any) List~Task~
        +collect_all_tasks() List~Task~
        +sort_by_time(tasks: Optional~List~Task~~) List~Task~
        +sort_by_priority(tasks: Optional~List~Task~~) List~Task~
        +filter_tasks(pet_name: Optional~str~, is_completed: Optional~bool~, priority: Optional~str~) List~Task~
        +find_next_available_slot(duration_minutes: int, search_date: date, work_day_start: time, work_day_end: time) Optional~datetime~
        +detect_conflicts(tasks: Optional~List~Task~~) List~Dict~
        +explain(plan: dict) str
    }

    Owner "1" *-- "0..*" Pet : cares for
    Pet "1" *-- "0..*" Task : needs
    Scheduler ..> Owner : reads constraints from
    Scheduler ..> Pet : schedules tasks for
